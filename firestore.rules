rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 관련 행사(관리자가 콘솔/관리 도구로 갱신): 누구나 읽기만
    match /meta/{doc} {
      allow read: if true;
      allow write: if false;
    }
    // BEST 커피 맛집: 누구나 읽기, 관리자(admin 클레임)만 쓰기
    match /stays/{course} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    match /cafes/{course} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    // 내 메달·준비물: 본인만 읽고 씀 (기부 기록은 여기에 쓸 수 없음)
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(['donated']);
    }
    // 기부 기록(메달 색): 본인만 읽기, 쓰기는 서버(결제 승인)만
    match /donations/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    // 인증서 메일 발송 간격 기록: 서버만
    match /certSend/{uid} {
      allow read, write: if false;
    }
    // 결제 주문: 서버만 읽고 씀 (관리자는 콘솔에서 확인)
    match /orders/{orderId} {
      allow read, write: if false;
    }
    // 코스 지점 사진: 누구나 보고, 로그인한 사람만 올리고, 올린 사람만 지움
    match /photos/{course}/items/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['url', 'path', 'at', 'by', 'pt'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.url is string
        && request.resource.data.path.matches('photos/' + request.auth.uid + '/.*');
      allow delete: if request.auth != null && resource.data.by == request.auth.uid;
    }
  }
}
